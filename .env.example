# Server only. Set one of these on the host. Do not commit a value.
# Vercel Preview and Production use closcam_gemini_api.
# GEMINI_API_KEY is the local fallback name.
closcam_gemini_api=
GEMINI_API_KEY=

# Optional. Without these, community reports stay in a local file on the server.
# SUPABASE_SERVICE_ROLE_KEY is server-only. Do not use a NEXT_PUBLIC_ name.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COMMUNITY_REPORTER_SALT=
